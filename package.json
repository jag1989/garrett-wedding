{
  "name": "garrett-wedding",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^26.0.0"
  },
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix --cache",
    "format": "prettier --write src/",
    "deploy": "pnpm run build && gh-pages -d dist --cname thegarrettwedding.co.uk"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "@lucide/vue": "^1.73.0",
    "pinia": "^4.1.0",
    "sass": "^1.108.2",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@tsconfig/node26": "^26.0.2",
    "@types/gh-pages": "^6.1.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "~10.12.1",
    "gh-pages": "^6.3.0",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.1",
    "npm-run-all2": "^9.0.4",
    "prettier": "3.10.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
